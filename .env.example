# ─────────────────────────────────────────────────────────────
# go-ya AI Gateway — Environment Configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_READ_TIMEOUT=30s
GATEWAY_WRITE_TIMEOUT=120s

# ── Database ─────────────────────────────────────────────────
# SQLite (development default):
GATEWAY_DB_DRIVER=sqlite
GATEWAY_DB_DSN=gateway.db

# PostgreSQL (production):
# GATEWAY_DB_DRIVER=postgres
# GATEWAY_DB_DSN=postgres://gateway:secret@localhost:5432/gateway?sslmode=disable

# ── Security ─────────────────────────────────────────────────
# REQUIRED: 64-character hex string (32 bytes). Generate with:
#   openssl rand -hex 32
GATEWAY_MASTER_KEY=<your-64-char-hex-key-here>

# Simple bearer-token auth (comma-separated, format: token:user_id).
# Leave empty to disable auth (all requests are anonymous).
# GATEWAY_AUTH_TOKENS=mysecrettoken:user-alice,anothertoken:user-bob

# ── Logging ──────────────────────────────────────────────────
# json (production) or text (development)
GATEWAY_LOG_FORMAT=text
GATEWAY_LOG_LEVEL=info

# ── Routing Defaults ─────────────────────────────────────────
# Provider name to use when no prefix is given in the model name.
# GATEWAY_DEFAULT_PROVIDER=openai
# GATEWAY_DEFAULT_MODEL=gpt-4o

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for all.
GATEWAY_CORS_ORIGINS=*

# ── OpenRouter Attribution ───────────────────────────────────
GATEWAY_OPENROUTER_REFERER=http://localhost
GATEWAY_OPENROUTER_TITLE=go-ya AI Gateway

# ── Caches & Retries ─────────────────────────────────────────
# How long to cache model lists from providers (e.g. OpenRouter).
GATEWAY_MODEL_CACHE_TTL=5m
# Max key rotation retries on rate-limit before failing.
GATEWAY_MAX_RETRIES=3
